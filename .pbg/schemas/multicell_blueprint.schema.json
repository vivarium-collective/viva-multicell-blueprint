{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivarium-collective.github.io/viva-template/schemas/multicell_blueprint.schema.json",
  "title": "multicell blueprint (backend-neutral)",
  "description": "Backend-neutral multi-cell model document (spec section 7). Compiled to a CPM or vertex mechanics backend; rule rate_expr strings are parsed by the rate grammar, not validated here. Accepts the flat v1 shape or the sectioned v2 shape (initial_conditions + model_definition).",
  "$defs": {
    "flat_v1": {
      "type": "object",
      "required": [
        "domain",
        "cell_types",
        "initial_state"
      ],
      "additionalProperties": false,
      "properties": {
        "blueprint_version": {
          "type": "string",
          "description": "Version of the canonical blueprint schema this document targets (BP-01). Optional for back-compat; recommended on every canonical artifact.",
          "minLength": 1
        },
        "domain": {
          "type": "object",
          "required": [
            "extent_um",
            "grid_resolution_um"
          ],
          "properties": {
            "extent_um": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "grid_resolution_um": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "boundary": {
              "enum": [
                "noflux",
                "periodic"
              ]
            }
          }
        },
        "cell_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "target_size"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "target_size": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mechanics": {
                "type": "object"
              },
              "mobile": {
                "type": "boolean"
              }
            }
          }
        },
        "adhesion": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "a",
              "b",
              "strength"
            ],
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "strength": {
                "type": "number"
              }
            }
          }
        },
        "initial_state": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "blocks",
                    "voronoi"
                  ]
                }
              }
            },
            {
              "required": [
                "from_data"
              ],
              "properties": {
                "from_data": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1,
                  "properties": {
                    "label_image": {
                      "type": "string"
                    },
                    "cell_table": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "required": [
                "cells"
              ],
              "properties": {
                "cells": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "centroid"
                    ],
                    "properties": {
                      "id": {
                        "type": [
                          "integer",
                          "string"
                        ]
                      },
                      "type": {
                        "type": "string"
                      },
                      "centroid": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "size": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "D",
              "decay"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "D": {
                "type": "number",
                "minimum": 0
              },
              "decay": {
                "type": "number",
                "minimum": 0
              },
              "secretion": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "rate"
                  ]
                }
              },
              "uptake": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "rate"
                  ]
                }
              },
              "chemotaxis": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "strength"
                  ]
                }
              },
              "dynamics": {
                "type": "object"
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "transition",
                  "kill",
                  "allee",
                  "resistance",
                  "recovery"
                ]
              },
              "rate_expr": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "transition"
                    }
                  }
                },
                "then": {
                  "required": [
                    "from",
                    "to",
                    "rate_expr"
                  ]
                }
              }
            ]
          }
        },
        "immune": {
          "type": [
            "object",
            "array"
          ]
        },
        "systemic_ode": {
          "type": "object",
          "required": [
            "model_ref"
          ],
          "properties": {
            "model_ref": {
              "type": "string"
            },
            "coupling": {
              "type": "object"
            }
          }
        },
        "mechanics_mapping": {
          "type": "object"
        },
        "subcellular": {
          "$ref": "#/$defs/subcellular"
        }
      }
    },
    "sectioned_v2": {
      "type": "object",
      "required": [
        "initial_conditions",
        "model_definition"
      ],
      "additionalProperties": false,
      "properties": {
        "blueprint_version": {
          "type": "string",
          "description": "Version of the canonical blueprint schema this document targets (BP-01). Optional for back-compat; recommended on every canonical artifact.",
          "minLength": 1
        },
        "initial_conditions": {
          "type": "object",
          "required": [
            "domain",
            "cell_types",
            "initial_state"
          ],
          "additionalProperties": false,
          "properties": {
            "domain": {
              "type": "object",
              "required": [
                "extent_um",
                "grid_resolution_um"
              ],
              "properties": {
                "extent_um": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "grid_resolution_um": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "boundary": {
                  "enum": [
                    "noflux",
                    "periodic"
                  ]
                }
              }
            },
            "initial_state": {
              "type": "object",
              "oneOf": [
                {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "blocks",
                        "voronoi"
                      ]
                    }
                  }
                },
                {
                  "required": [
                    "from_data"
                  ],
                  "properties": {
                    "from_data": {
                      "type": "object",
                      "minProperties": 1,
                      "maxProperties": 1,
                      "properties": {
                        "label_image": {
                          "type": "string"
                        },
                        "cell_table": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                {
                  "required": [
                    "cells"
                  ],
                  "properties": {
                    "cells": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "centroid"
                        ],
                        "properties": {
                          "id": {
                            "type": [
                              "integer",
                              "string"
                            ]
                          },
                          "type": {
                            "type": "string"
                          },
                          "centroid": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "size": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "cell_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "target_size"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_size": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "mechanics": {
                    "type": "object"
                  },
                  "mobile": {
                    "type": "boolean"
                  }
                }
              }
            },
            "adhesion": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "a",
                  "b",
                  "strength"
                ],
                "properties": {
                  "a": {
                    "type": "string"
                  },
                  "b": {
                    "type": "string"
                  },
                  "strength": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "model_definition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "D",
                  "decay"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "D": {
                    "type": "number",
                    "minimum": 0
                  },
                  "decay": {
                    "type": "number",
                    "minimum": 0
                  },
                  "secretion": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "rate"
                      ]
                    }
                  },
                  "uptake": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "rate"
                      ]
                    }
                  },
                  "chemotaxis": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "strength"
                      ]
                    }
                  },
                  "dynamics": {
                    "type": "object"
                  }
                }
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "transition",
                      "kill",
                      "allee",
                      "resistance",
                      "recovery"
                    ]
                  },
                  "rate_expr": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "transition"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "from",
                        "to",
                        "rate_expr"
                      ]
                    }
                  }
                ]
              }
            },
            "immune": {
              "type": [
                "object",
                "array"
              ]
            },
            "systemic": {
              "type": "object",
              "required": [
                "model_ref"
              ],
              "properties": {
                "model_ref": {
                  "type": "string"
                },
                "coupling": {
                  "type": "object"
                }
              }
            },
            "mechanics_mapping": {
              "type": "object"
            },
            "subcellular": {
              "$ref": "#/$defs/subcellular"
            }
          }
        }
      }
    },
    "subcellular": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "module"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/flat_v1"
    },
    {
      "$ref": "#/$defs/sectioned_v2"
    }
  ]
}
